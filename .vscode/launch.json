{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug full flow test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\tests\\test_full_flow.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "args": [
        "--config",
        "${workspaceFolder}\\config\\booking.debug.json",
        "--allow-submit",
        "--start-time",
        "07:00",
        "--end-time",
        "08:00",
        "--days-ahead",
        "2"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
